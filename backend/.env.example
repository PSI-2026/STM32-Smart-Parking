# Values are NOT loaded automatically. Set PARKING_* in the process environment.
PARKING_MODE=simulation
PARKING_DATABASE_PATH=backend/data/parking.sqlite3
PARKING_TRANSPORT=TCP
PARKING_ALLOW_ANONYMOUS_SIMULATION=false
# Generate distinct random tokens (at least 32 non-whitespace characters).
# Leave optional roles unset, rather than setting an empty token.
# PARKING_VIEWER_TOKEN=<generated-viewer-token>
# PARKING_OPERATOR_TOKEN=<generated-operator-token>
# PARKING_ADMIN_TOKEN=<generated-admin-token>
PARKING_HARDWARE_ENABLED=false
PARKING_HARDWARE_PROFILE=distributed-v2.1
# Physical firmware v1 diagnostic: see LEGACY_READONLY.md (USB, 115200, separate DB).
# PARKING_HARDWARE_PROFILE=hybrid-v1-readonly
# PARKING_LEGACY_UNIT_ID=1
# PARKING_LEGACY_POLL_INTERVAL_SECONDS=0.5
# PARKING_LEGACY_STALE_AFTER_MS=2000
PARKING_MODBUS_HOST=127.0.0.1
PARKING_MODBUS_PORT=502
PARKING_MODBUS_SERIAL_PORT=COM3
PARKING_MODBUS_BAUDRATE=19200
PARKING_MODBUS_PARITY=N
PARKING_MODBUS_TIMEOUT_SECONDS=0.3
